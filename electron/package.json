{
  "name": "doost-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Doost - desktop wrapper",
  "main": "main.js",
  "scripts": {
    "electron:start": "electron .",
    "electron:pack": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.shahinsoft.doost",
    "productName": "Doost",
    "asar": true,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Education"
    }
  }
}
