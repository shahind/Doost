{
  "name": "doost",
  "version": "2.0.1",
  "private": true,
  "description": "Doost (دوست) — fast, lightweight, fully offline Persian poetry library (Ganjoor) for web, Android, iOS, Windows and Linux",
  "author": {
    "name": "Shahin",
    "email": "shahin.shdm@gmail.com"
  },
  "homepage": "https://shahind.github.io/Doost/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shahind/Doost.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:data": "node --no-warnings --max-old-space-size=8192 tools/build-data.mjs",
    "test": "node --no-warnings tools/test-search.mjs",
    "serve": "node tools/serve.mjs",
    "vendor": "node -e \"require('fs').copyFileSync('node_modules/@capacitor/core/dist/capacitor.js','www/js/vendor/capacitor.js')\"",
    "electron": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "cap:sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "assets": "capacitor-assets generate --android --ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.shahinsoft.doost",
    "productName": "Doost",
    "copyright": "Doost — Persian poetry",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "electron/main.cjs",
      "www/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Doost-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/build/icon.png",
      "category": "Education",
      "maintainer": "Shahin <shahin.shdm@gmail.com>"
    },
    "appx": {
      "applicationId": "Doost",
      "displayName": "دوست — گنجینه همراه شعر پارسی",
      "identityName": "Shahin.Doost",
      "publisher": "CN=Shahin",
      "publisherDisplayName": "Shahin",
      "backgroundColor": "#35646a",
      "languages": [
        "fa-IR",
        "en-US"
      ],
      "showNameOnTiles": false,
      "artifactName": "${productName}-${version}-store.${ext}"
    },
    "electronLanguages": [
      "fa",
      "en-US"
    ],
    "portable": {
      "artifactName": "Doost-Portable-${version}.${ext}"
    }
  }
}
